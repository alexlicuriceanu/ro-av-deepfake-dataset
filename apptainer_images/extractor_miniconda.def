Bootstrap: docker
From: continuumio/miniconda3:latest

%labels
    Maintainer alicuriceanu
    Description "Miniconda + tmux"

%environment
    export CONDA_AUTO_ACTIVATE_BASE=false
    export PYTHONNOUSERSITE=1
    . /opt/conda/etc/profile.d/conda.sh

%post
    export DEBIAN_FRONTEND=noninteractive
    echo 'APT::Sandbox::User "root";' > /etc/apt/apt.conf.d/sandbox-disable
    
    apt-get update
    apt-get install -y fakeroot
    
    FAKEROOTDONTTRYCHOWN=1 fakeroot sh -c '
        # Install system dependencies and python venv module
        apt-get install -y git ffmpeg libsm6 libxext6 libgl1 libgles2 wget
    '

    conda config --system --set channel_priority strict
    conda install --yes --channel conda-forge python=3.10 tmux
    conda clean --all --yes

%runscript
    exec /bin/bash "$@"
