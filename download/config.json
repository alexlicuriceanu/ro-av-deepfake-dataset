{
    "csv_files": [
        {
            "file": "../csv/muntenia_videos.csv",
            "dialect": "muntenia"
        },
        {
            "file": "../csv/transilvania_videos.csv",
            "dialect": "transilvania"
        },
        {
            "file": "../csv/maramures_videos.csv",
            "dialect": "maramures"
        },
	    {
            "file": "../csv/moldova_videos.csv",
            "dialect": "moldova"
        },
        {
            "file": "../csv/rep_moldova_videos.csv",
            "dialect": "rep_moldova"
        }
    ],
    "output_dir": "../videos_raw",
    "log_file": "./download.log",
    "yt_dlp_options": {
        "format": "bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best",
